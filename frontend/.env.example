# Frontend build-time configuration.
#
# None of this is required for local development: with both unset, the app
# talks to the real FastAPI backend through Vite's dev proxy (see
# vite.config.ts), which is what you want when running the full stack.
#
# Anything prefixed VITE_ is inlined into the JavaScript bundle and is
# therefore PUBLIC. Never put a secret here — the backend holds all of those,
# in backend/.env.

# Serve the UI from a captured snapshot of API responses instead of calling a
# backend (see src/demo/). Set to "true" on the public Vercel deployment,
# which is frontend-only. Any other value, or unset, leaves it off.
VITE_DEMO_MODE=false

# Repository the demo banner's "Source" link points at.
VITE_REPO_URL=https://github.com/sajishnu-js/agentra
