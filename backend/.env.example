# Copy to .env and adjust. Values below match docker-compose.yml defaults.

ENVIRONMENT=local
DEBUG=true

# Postgres (pgvector) — the port is 5433 to avoid clashing with any
# system Postgres already listening on 5432.
DATABASE_URL=postgresql+asyncpg://agentra:agentra@localhost:5433/agentra
# Set true to log every SQL statement.
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6380/0

# Frontend origin allowed through CORS
CORS_ORIGINS=http://localhost:5173

# Local embedding model. Must be 1024-dimension to match kb_chunks.embedding.
#   BAAI/bge-m3                     — default, no prefixes, 8192-token window
#   intfloat/multilingual-e5-large  — needs query:/passage: prefixes (handled)
EMBEDDING_MODEL=BAAI/bge-m3

# Leave blank to let sentence-transformers choose (mps on Apple Silicon,
# otherwise cpu). Set to cpu / mps / cuda to pin it.
EMBEDDING_DEVICE=

# Embedding *width* is NOT configured here — it is baked into the column type.
# See EMBEDDING_DIMENSIONS in app/domains/knowledge_base/models.py.

# --- Business ---
# IANA tz name. Used for the business-hours badge and for bucketing analytics
# ("today") in local time rather than UTC.
BUSINESS_TIMEZONE=UTC

# This deployment's own public HTTPS origin (no trailing slash) — needed so a
# channel can be given a reachable URL for an uploaded file rather than a bare
# relative /uploads/... path. Required for Instagram attachments specifically
# (its Send API takes a URL, not an upload); used as a text fallback link on
# any channel that has nothing better.
PUBLIC_BASE_URL=

# --- Channels ---
# From @BotFather in Telegram. The bot refuses to start without it.
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API — developers.facebook.com, WhatsApp product on the
# business's app. WHATSAPP_APP_SECRET is the *app's* secret (App Settings >
# Basic), not the access token — it verifies the webhook's HMAC signature.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Instagram Messaging API — same Meta app family, scoped to the Instagram
# account's linked Page.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# Outbound email over plain SMTP. Inbound arrives via a provider's inbound-
# parse webhook (SendGrid/Postmark/Mailgun), authenticated by
# EMAIL_WEBHOOK_SECRET rather than IMAP polling.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
EMAIL_WEBHOOK_SECRET=

# --- LLM ---
# "gemini" for the real thing, "echo" to exercise the whole pipeline with no
# API key and no token spend.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Pinned rather than a floating alias like gemini-flash-latest, so the model
# cannot change under the business without a deliberate edit.
GEMINI_MODEL=gemini-3.6-flash

# --- Handover ---
# Lowest model-reported confidence still allowed to reach a customer.
#   high   strict — only fully grounded answers go out
#   medium default
#   low    effectively disables the self-assessment gate
# Hard keyword rules are unaffected by this.
AI_MIN_CONFIDENCE=medium

# Set false to turn off the hard keyword layer. Only useful for measuring how
# the model behaves without it.
KEYWORD_HANDOVER_ENABLED=true

# --- Request extraction ---
# A second model call per turn, purely to classify the message into a Requests
# Hub row. Set false to halve model usage, at the cost of the Hub not filling
# itself. Note this doubles per-turn quota consumption when on.
REQUEST_EXTRACTION_ENABLED=true
# Earlier messages sent as context, so "yes, Thursday works" can be resolved.
EXTRACTION_HISTORY_MESSAGES=8

# --- Retrieval ---
RETRIEVAL_TOP_K=5
# Cosine floor. bge-m3 scores are compressed: good matches land ~0.44-0.55 and
# nonsense still scores ~0.39, so this is a loose net rather than a real
# filter. The grounding instruction in the prompt is the actual guard.
RETRIEVAL_MIN_SIMILARITY=0.40

# --- Queue ---
RQ_QUEUE_NAME=agentra
RQ_JOB_TIMEOUT=180
